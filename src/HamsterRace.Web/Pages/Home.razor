@page "/"
@using HamsterRace.Domain
@inject GameData Game

<div class="wrap">
    <header class="hd">
        <h1>🐹 鼠鼠競賽</h1>
        <span class="sub">Project Hamster · 教練模式</span>
    </header>

    <ErrorBoundary @ref="_eb">
    <ChildContent>
    @if (!Game.Loaded)
    {
        <p class="loading">載入中… 🎐</p>
    }
    else if (_phase == Phase.Config)
    {
        var env = TrackEnv();

        <section class="pick">
            <h2>① 選賽道</h2>
            <div class="track-row">
                @foreach (var (id, _) in Game.Races)
                {
                    var tid = id;
                    <button class="pill @(tid == _trackId ? "sel" : "")" @onclick="() => _trackId = tid">@Terrain(TerrainOf(tid))</button>
                }
            </div>
            <div class="intel">
                <div class="intel-line">🌦️ 天氣預報：@Forecast(env.WeatherForecast, WeatherName)</div>
                <div class="intel-line">🌬️ 風向預報：@Forecast(env.WindForecast, WindName)</div>
                <div class="intel-hint">實際天氣鎖牌後才抽 → 要不要押天氣自己賭 🎲</div>
            </div>
        </section>

        <section class="pick">
            <h2>② 選你要指導的鼠鼠</h2>
            <div class="hamster-row">
                @for (int i = 0; i < Game.Hamsters.Count; i++)
                {
                    var idx = i; var h = Game.Hamsters[i];
                    <button class="hamster-card @(idx == _meIndex ? "sel" : "")" @onclick="() => SelectHamster(idx)">
                        <div class="hc-emoji">🐹</div>
                        <div class="hc-name">@h.Name</div>
                        <div class="hc-stat">@($"速 {h.BaseSpeed:0.0} · HP {h.MaxHp} · MP {h.MaxMp}")</div>
                        <div class="hc-aff">@Affinities(h)</div>
                    </button>
                }
            </div>
        </section>

        <section class="pick">
            <h2>③ 配牌（6 槽）<span class="count @(DeckCount() == 6 ? "ok" : "")">@DeckCount() / 6</span></h2>
            <div class="cost-preview">
                🔋 本套牌消耗預估：<b>HP @DeckCost().Hp</b> ／ <b>MP @DeckCost().Mp</b>
                <span class="cost-note">（另有基礎體力消耗：每 10m 約 5 HP＋5 MP）</span>
            </div>
            @foreach (var (key, label) in Slots)
            {
                var slotKey = key;
                <div class="slot">
                    <div class="slot-label">@label</div>
                    <div class="slot-cards">
                        @foreach (var c in CardsForSlot(slotKey))
                        {
                            var cid = c.Id;
                            <button class="chip @(_slots[slotKey] == cid ? "sel" : "")" @onclick="() => PickCard(slotKey, cid)">
                                <span class="chip-name">@c.Name</span>
                                <span class="chip-eff">@CardEffect(c)@(c.ConditionType is not null ? $" 🎲{CondName(c)}" : "")</span>
                            </button>
                        }
                    </div>
                </div>
            }
            <div class="deck-actions">
                <button class="ghost" @onclick="UseDefault">用這隻鼠的預設牌組</button>
                <button class="ghost" @onclick="ClearDeck">清空</button>
            </div>
        </section>

        <section class="pick">
            <h2>④ 專屬技能（兩選一 ＋ 發動時機）</h2>
            <div class="skill-row">
                @foreach (var sid in Game.Hamsters[_meIndex].Skills)
                {
                    var s = Game.Skills[sid];
                    <button class="skill-card @(sid == _skillId ? "sel" : "")" @onclick="() => _skillId = sid">
                        <div class="sk-name">@s.Name</div>
                        <div class="sk-eff">@SkillEffect(s)</div>
                    </button>
                }
            </div>
            <div class="trig-label">發動時機：</div>
            <div class="trig-row">
                @foreach (var t in Triggers)
                {
                    var tt = t;
                    <button class="pill sm @(tt.Label == _trigLabel ? "sel" : "")" @onclick="() => SetTrigger(tt)">@tt.Label</button>
                }
            </div>
        </section>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="err">⚠️ @_error</div>
        }
        <button class="start" disabled="@(DeckCount() == 0)" @onclick="StartRace">
            🏁 開賽！@(DeckCount() == 0 ? "（至少放一張牌）" : "")
        </button>
    }
    else
    {
        <section class="race">
            <div class="race-banner">
                <span>🏟️ @Terrain(_result!.Terrain)</span>
                <span>🌦️ @WeatherName(_result.ActualWeather)</span>
                <span>🌬️ @WindName(_result.ActualWind)</span>
                <span class="clock">@($"{CurrentTime:0.0}")s</span>
            </div>

            <div class="track">
                @for (int i = 0; i < _result.Replay!.HamsterNames.Count; i++)
                {
                    var pct = LanePct(i);
                    var isMe = i == _meIndex;
                    <div class="lane">
                        <div class="lane-name @(isMe ? "me" : "")">@_result.Replay.HamsterNames[i]@(isMe ? " ⭐" : "")</div>
                        <div class="lane-track">
                            <div class="runner" style="left:calc(@pct% - 14px)">🐹</div>
                            <div class="finish">🏁</div>
                        </div>
                    </div>
                }
            </div>

            <div class="ticker">@_currentEvent</div>

            @if (_phase == Phase.Result)
            {
                <div class="result">
                    <h2>🏁 最終名次</h2>
                    <ol class="standings">
                        @foreach (var r in _result.Rankings)
                        {
                            <li class="@(r.HamsterId == Game.Hamsters[_meIndex].Id ? "me" : "")">
                                <span class="rk">@r.Rank</span>
                                <span class="rn">@r.Name @(r.HamsterId == Game.Hamsters[_meIndex].Id ? "⭐" : "")</span>
                                <span class="rt">@FmtTime(r.FinishTimeSeconds)</span>
                                <span class="rd">@($"剩HP {r.RemainingHp:0}／MP {r.RemainingMp:0}｜出牌{r.CardsFired}")@(r.CardsFizzled > 0 ? $"(啞{r.CardsFizzled})" : "")@($"｜技{r.SkillsFired}")</span>
                            </li>
                        }
                    </ol>
                    <div class="myline">@MyResultLine()</div>
                    <div class="again">
                        <button class="start" @onclick="ReplayRace">▶️ 重播這場</button>
                        <button class="start" @onclick="StartRace">🔁 同設定·再抽天氣</button>
                        <button class="ghost" @onclick="BackToConfig">⚙️ 回配置</button>
                    </div>

                    <details class="report" open>
                        <summary>📜 完整戰報（逐段實況）</summary>
                        <div class="report-log">
                            @foreach (var e in _result.Events)
                            {
                                <div class="rl-line"><span class="rl-t">@($"{e.TimeSeconds,5:0.0}s")</span> @e.Message</div>
                            }
                        </div>
                    </details>
                </div>
            }
        </section>
    }

    </ChildContent>
    <ErrorContent Context="ex">
        <div class="err">😵 畫面出了個錯（我在抓原因）：<br /><b>@ex.GetType().Name</b>: @ex.Message
            <br /><button class="ghost" @onclick="Recover">回配置重試</button>
        </div>
    </ErrorContent>
    </ErrorBoundary>

    <footer class="ft">聆音 × 卡凡 · 確定性引擎 C#/.NET</footer>
</div>

@code {
    enum Phase { Config, Racing, Result }
    Phase _phase = Phase.Config;

    static readonly (string Key, string Label)[] Slots =
    {
        ("start", "起跑"), ("accel", "加速"), ("mid", "中期"),
        ("sprint", "衝刺"), ("func1", "功能 a"), ("func2", "功能 b")
    };

    record Trig(string Label, SkillTrigger T, double V);
    static readonly Trig[] Triggers =
    {
        new("開賽就放", SkillTrigger.Periodic, 0),
        new("剩 50m", SkillTrigger.RemainingM, 50),
        new("剩 20m", SkillTrigger.RemainingM, 20),
        new("落後時", SkillTrigger.RankBehind, 0),
        new("體力不支", SkillTrigger.HpBelow, 0.35),
    };

    Microsoft.AspNetCore.Components.Web.ErrorBoundary? _eb;
    void Recover() { _phase = Phase.Config; _eb?.Recover(); }

    string _trackId = "grass";
    int _meIndex = 0;
    readonly Dictionary<string, string?> _slots = new()
    { ["start"] = null, ["accel"] = null, ["mid"] = null, ["sprint"] = null, ["func1"] = null, ["func2"] = null };
    string _skillId = "";
    string _trigLabel = "剩 20m";
    Trig _trig = Triggers[2];

    RaceResult? _result;
    int _frame;
    string _currentEvent = "";

    double CurrentTime => _result?.Replay is { Frames.Count: > 0 } rp
        ? rp.Frames[Math.Min(_frame, rp.Frames.Count - 1)].T : 0;

    protected override async Task OnInitializedAsync()
    {
        await Game.EnsureLoadedAsync();
        _trackId = Game.Races.Count > 0 ? Game.Races[0].Id : "grass";
        SelectHamster(0);
    }

    RaceEnvironment TrackEnv()
    {
        foreach (var (id, e) in Game.Races) if (id == _trackId) return e;
        return Game.Races.Count > 0 ? Game.Races[0].Env : new RaceEnvironment();
    }
    string TerrainOf(string trackId)
    {
        foreach (var (id, e) in Game.Races) if (id == trackId) return e.Terrain;
        return "grass";
    }

    void SelectHamster(int i)
    {
        _meIndex = i;
        ClearDeck();
        var sk = Game.Hamsters[i].Skills;
        _skillId = sk.Count > 0 ? sk[0] : "";
    }

    IEnumerable<Card> CardsForSlot(string slotKey)
    {
        string type = slotKey is "func1" or "func2" ? "function" : slotKey;
        string? other = slotKey == "func1" ? _slots["func2"] : slotKey == "func2" ? _slots["func1"] : null;
        return Game.Cards.Values.Where(c => c.Slot == type && (other is null || c.Id != other));
    }

    void PickCard(string slotKey, string cardId)
        => _slots[slotKey] = _slots[slotKey] == cardId ? null : cardId;

    int DeckCount() => _slots.Values.Count(v => v is not null);
    List<string> Deck() => _slots.Values.Where(v => v is not null).Select(v => v!).ToList();

    void ClearDeck()
    {
        foreach (var k in _slots.Keys.ToList()) _slots[k] = null;
    }

    void UseDefault()
    {
        ClearDeck();
        int f = 1;
        foreach (var cid in Game.Hamsters[_meIndex].Deck)
        {
            if (!Game.Cards.TryGetValue(cid, out var c)) continue;
            if (c.Slot == "function") { if (f <= 2) _slots["func" + f++] = cid; }
            else if (_slots.ContainsKey(c.Slot) && _slots[c.Slot] is null) _slots[c.Slot] = cid;
        }
    }

    void SetTrigger(Trig t) { _trig = t; _trigLabel = t.Label; }
    void BackToConfig() => _phase = Phase.Config;

    async Task ReplayRace()
    {
        if (_result?.Replay is null) return;
        _phase = Phase.Racing;
        _frame = 0;
        _currentEvent = "🔁 重播開始！";
        StateHasChanged();
        await PlayAsync();
    }

    string _error = "";

    (int Hp, int Mp) DeckCost()
    {
        int hp = 0, mp = 0;
        foreach (var cid in Deck())
            if (Game.Cards.TryGetValue(cid, out var c)) { hp += c.HpCost; mp += c.MpCost; }
        return (hp, mp);
    }

    async Task StartRace()
    {
        _error = "";
        var deck = Deck();
        if (deck.Count == 0) return;
        if (string.IsNullOrEmpty(_skillId)) _skillId = Game.Hamsters[_meIndex].Skills.FirstOrDefault() ?? "";
        try
        {
            ulong seed = unchecked((ulong)(Random.Shared.NextInt64() ^ DateTime.Now.Ticks));
            _result = Game.Simulate(_meIndex, _trackId, deck, _skillId, _trig.T, _trig.V, seed);
        }
        catch (Exception ex)
        {
            _error = "跑比賽時出錯了：" + ex.Message;
            StateHasChanged();
            return;
        }
        _phase = Phase.Racing;
        _frame = 0;
        _currentEvent = "比賽開始！";
        StateHasChanged();
        await PlayAsync();
    }

    bool _playing;

    async Task PlayAsync()
    {
        if (_playing) return;            // 防重入,避免兩個動畫迴圈疊在一起
        _playing = true;
        try
        {
            var rp = _result!.Replay!;
            var events = _result.Events;
            int total = rp.Frames.Count;
            int steps = Math.Min(total, 55);   // 降頻:最多 55 個視覺步(而非每幀),大幅降低 render 壓力
            int evIdx = 0;
            for (int s = 1; s <= steps; s++)
            {
                _frame = (int)((long)s * (total - 1) / steps);
                double t = rp.Frames[Math.Clamp(_frame, 0, total - 1)].T;
                while (evIdx < events.Count && events[evIdx].TimeSeconds <= t)
                {
                    if (events[evIdx].HamsterId != "-") _currentEvent = events[evIdx].Message;
                    evIdx++;
                }
                await InvokeAsync(StateHasChanged);
                await Task.Delay(120);
            }
        }
        catch { /* 動畫中的例外不致命 */ }
        finally
        {
            _frame = Math.Max(0, (_result?.Replay?.Frames.Count ?? 1) - 1);
            _phase = Phase.Result;
            _currentEvent = "衝線！";
            _playing = false;
            try { await InvokeAsync(StateHasChanged); } catch { }
        }
    }

    double LanePct(int i)
    {
        var rp = _result!.Replay!;
        if (rp.Frames.Count == 0) return 0;
        double d = rp.Frames[Math.Min(_frame, rp.Frames.Count - 1)].Distances[i];
        return Math.Clamp(d / rp.DistanceMeters * 100.0, 0, 100);
    }

    string MyResultLine()
    {
        var me = _result!.Rankings.First(r => r.HamsterId == Game.Hamsters[_meIndex].Id);
        return me.Rank == 1
            ? $"🏆 你的 {me.Name} 拿下第 1 名！配牌成功！"
            : $"你的 {me.Name} 這場第 {me.Rank} 名——換個配牌或賭賭天氣再來？";
    }

    string CardEffect(Card c)
    {
        var p = new List<string>();
        if (c.SpeedBonus != 0) p.Add($"+{c.SpeedBonus:0.0}速");
        if (c.HpRecover > 0 || c.MpRecover > 0) p.Add($"回HP{c.HpRecover}/MP{c.MpRecover}");
        if (c.DrainMultiplier != 1.0) p.Add($"省耗×{c.DrainMultiplier:0.0}");
        if (c.HpCost > 0 || c.MpCost > 0) p.Add($"耗{c.HpCost}/{c.MpCost}");
        return string.Join(" ", p);
    }

    string SkillEffect(Skill s)
    {
        if (s.HpRecover > 0 || s.MpRecover > 0) return $"回HP{s.HpRecover}/MP{s.MpRecover} · 冷卻{s.CooldownSeconds:0}s";
        return $"+{s.SpeedBonus:0.0}速 {s.DurationSeconds:0.0}s · 冷卻{s.CooldownSeconds:0}s · 耗{s.HpCost}/{s.MpCost}";
    }

    string FmtTime(double t) => double.IsInfinity(t) ? "未完賽" : $"{t:0.0}s";

    string Affinities(Hamster h)
    {
        var l = new List<string>();
        foreach (var (k, v) in h.WeatherAffinity) if (v > 1.0) l.Add(WeatherName(k));
        foreach (var (k, v) in h.WindAffinity) if (v > 1.0) l.Add(WindName(k));
        foreach (var (k, v) in h.TerrainAffinity) if (v > 1.0) l.Add(Terrain(k));
        return l.Count > 0 ? "擅長 " + string.Join("/", l) : "無明顯弱點";
    }

    string CondName(Card c) => c.ConditionType switch
    {
        "weather" => WeatherName(c.ConditionValue ?? ""),
        "wind" => WindName(c.ConditionValue ?? ""),
        "terrain" => Terrain(c.ConditionValue ?? ""),
        _ => c.ConditionValue ?? ""
    };

    string Forecast(IReadOnlyDictionary<string, double> f, Func<string, string> n)
        => string.Join(" / ", f.OrderByDescending(x => x.Value).Select(x => $"{n(x.Key)} {x.Value * 100:0}%"));

    string Terrain(string k) => k switch { "track" => "運動場", "grass" => "草地", "asphalt" => "柏油", _ => k };
    string WeatherName(string k) => k switch { "normal" => "一般", "sunny" => "大晴天", "rain" => "大雨", _ => k };
    string WindName(string k) => k switch { "none" => "無風", "tail" => "順風", "head" => "逆風", _ => k };
}
